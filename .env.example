# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dormitory

# Random long string used to sign login session tokens (generate with: openssl rand -hex 32)
JWT_SECRET=change-this-to-a-long-random-string

# Port the server listens on
PORT=3000

# LINE Messaging API (see README "LINE integration" section) — optional, only
# needed if you want automatic bill notifications sent to tenants' LINE.
LINE_CHANNEL_ACCESS_TOKEN=
