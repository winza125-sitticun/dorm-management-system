diff --git a/tests/license-state-backup-boundary.test.mjs b/tests/license-state-backup-boundary.test.mjs
new file mode 100644
index 0000000..5ba6f2d
--- /dev/null
+++ b/tests/license-state-backup-boundary.test.mjs
@@ -0,0 +1,23 @@
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import test from 'node:test';
+
+const read = (relative) => readFileSync(new URL(`../${relative}`, import.meta.url), 'utf8');
+
+test('license_state is explicitly excluded from application backup and absent from backup payload tables', () => {
+  const service = read('src/server/services/backup.service.ts');
+  const format = read('src/utils/backupFormat.ts');
+  const excludedBlock = service.slice(service.indexOf('export const BACKUP_EXCLUDED'), service.indexOf('] as const;', service.indexOf('export const BACKUP_EXCLUDED')));
+  const tablesBlock = format.slice(format.indexOf('export const BACKUP_TABLES'), format.indexOf('] as const;', format.indexOf('export const BACKUP_TABLES')));
+  assert.match(excludedBlock, /'license_state'/);
+  assert.doesNotMatch(tablesBlock, /license_state/);
+});
+
+test('restore allowlists never delete insert or update license_state', () => {
+  const restore = read('src/server/services/restore.service.ts');
+  const deleteBlock = restore.slice(restore.indexOf('export const RESTORE_DELETE_ORDER'), restore.indexOf('] as const;', restore.indexOf('export const RESTORE_DELETE_ORDER')));
+  const insertBlock = restore.slice(restore.indexOf('export const RESTORE_INSERT_ORDER'), restore.indexOf('] as const;', restore.indexOf('export const RESTORE_INSERT_ORDER')));
+  assert.doesNotMatch(deleteBlock, /license_state/);
+  assert.doesNotMatch(insertBlock, /license_state/);
+  assert.doesNotMatch(restore, /(?:DELETE\s+FROM|INSERT\s+(?:OR\s+\w+\s+)?INTO|UPDATE)\s+license_state/i);
+});
diff --git a/tests/license-state-migration.test.mjs b/tests/license-state-migration.test.mjs
new file mode 100644
index 0000000..1d35169
--- /dev/null
+++ b/tests/license-state-migration.test.mjs
@@ -0,0 +1,45 @@
+import assert from 'node:assert/strict';
+import { readFileSync, readdirSync } from 'node:fs';
+import test from 'node:test';
+
+const root = new URL('../', import.meta.url);
+const read = (relative) => readFileSync(new URL(relative, root), 'utf8');
+
+function migrations() {
+  return readdirSync(new URL('d1-migrations/', root)).filter((name) => name.endsWith('.sql')).sort();
+}
+
+test('V16 Task 2 adds exactly migration 0007 for singleton license_state', () => {
+  const names = migrations();
+  assert.equal(names.at(-1), '0007_add_license_state.sql');
+  assert.equal(names.some((name) => /^0008|^0009|^00[1-9][0-9]/.test(name)), false);
+  const migration = read('d1-migrations/0007_add_license_state.sql');
+  assert.match(migration, /CREATE TABLE IF NOT EXISTS license_state/i);
+  assert.match(migration, /id INTEGER PRIMARY KEY CHECK\s*\(id = 1\)/i);
+  assert.match(migration, /installation_id TEXT NOT NULL/i);
+  assert.match(migration, /signed_token TEXT/i);
+  assert.match(migration, /status TEXT NOT NULL DEFAULT 'unlicensed'/i);
+  assert.match(migration, /effective_plan TEXT/i);
+  assert.match(migration, /last_checked_at TEXT/i);
+  assert.match(migration, /grace_until TEXT/i);
+  assert.match(migration, /expires_at TEXT/i);
+  assert.match(migration, /control_plane_url TEXT NOT NULL/i);
+  assert.match(migration, /updated_at TEXT NOT NULL/i);
+  assert.doesNotMatch(migration, /updated_at TEXT NOT NULL DEFAULT/i);
+});
+
+test('schema_d1 and Drizzle expose the same license_state persistence contract', () => {
+  const schemaD1 = read('schema_d1.sql');
+  const drizzle = read('src/db/schema.ts');
+  assert.match(schemaD1, /CREATE TABLE IF NOT EXISTS license_state/i);
+  assert.match(schemaD1, /id INTEGER PRIMARY KEY CHECK\s*\(id = 1\)/i);
+  assert.match(schemaD1, /status TEXT NOT NULL DEFAULT 'unlicensed'/i);
+  assert.match(schemaD1, /control_plane_url TEXT NOT NULL/i);
+  assert.match(schemaD1, /updated_at TEXT NOT NULL/i);
+  assert.doesNotMatch(schemaD1, /updated_at TEXT NOT NULL DEFAULT/i);
+  assert.match(drizzle, /export const licenseState = sqliteTable\('license_state'/);
+  assert.match(drizzle, /installationId: text\('installation_id'\)\.notNull\(\)/);
+  assert.match(drizzle, /status: text\('status'\)\.default\('unlicensed'\)\.notNull\(\)/);
+  assert.match(drizzle, /controlPlaneUrl: text\('control_plane_url'\)\.notNull\(\)/);
+  assert.match(drizzle, /updatedAt: text\('updated_at'\)\.notNull\(\)/);
+});
diff --git a/tests/license-state-service.test.ts b/tests/license-state-service.test.ts
new file mode 100644
index 0000000..608812e
--- /dev/null
+++ b/tests/license-state-service.test.ts
@@ -0,0 +1,150 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { ensureLicenseState, readLicenseState } from '../src/server/services/license.service.ts';
+
+type RawLicenseState = {
+  id: number;
+  installation_id: string;
+  signed_token: string | null;
+  status: string;
+  effective_plan: string | null;
+  last_checked_at: string | null;
+  grace_until: string | null;
+  expires_at: string | null;
+  control_plane_url: string;
+  updated_at: string;
+};
+
+class FakeStatement {
+  private args: unknown[] = [];
+  private db: FakeLicenseD1;
+  private sql: string;
+  constructor(db: FakeLicenseD1, sql: string) { this.db = db; this.sql = sql; }
+  bind(...values: unknown[]) { this.args = values; return this; }
+  async first<T = Record<string, unknown>>(): Promise<T | null> {
+    return this.db.first(this.sql, this.args) as T | null;
+  }
+  async run(): Promise<{ success?: boolean }> {
+    await this.db.run(this.sql, this.args);
+    return { success: true };
+  }
+}
+
+class FakeLicenseD1 {
+  row: RawLicenseState | null = null;
+  statements: string[] = [];
+  insertAttempts = 0;
+  constructor(row: RawLicenseState | null = null) { this.row = row; }
+  prepare(sql: string) { this.statements.push(sql); return new FakeStatement(this, sql); }
+  private normalized(sql: string) { return sql.replace(/\s+/g, ' ').trim().toLowerCase(); }
+  first(sql: string, args: unknown[]): RawLicenseState | null {
+    const q = this.normalized(sql);
+    assert.match(q, /^select .* from license_state where id = 1 limit 1$/i);
+    assert.deepEqual(args, []);
+    return this.row ? { ...this.row } : null;
+  }
+  async run(sql: string, args: unknown[]) {
+    const q = this.normalized(sql);
+    assert.match(q, /^insert or ignore into license_state /i);
+    assert.deepEqual(args.length, 5);
+    this.insertAttempts += 1;
+    await new Promise((resolve) => setTimeout(resolve, 0));
+    if (this.row) return;
+    this.row = {
+      id: Number(args[0]),
+      installation_id: String(args[1]),
+      signed_token: null,
+      status: String(args[2]),
+      effective_plan: null,
+      last_checked_at: null,
+      grace_until: null,
+      expires_at: null,
+      control_plane_url: String(args[3]),
+      updated_at: String(args[4]),
+    };
+  }
+}
+
+function validRaw(overrides: Partial<RawLicenseState> = {}): RawLicenseState {
+  return {
+    id: 1,
+    installation_id: '8cd13a85-a578-44d6-9efb-68730d57dcc3',
+    signed_token: null,
+    status: 'unlicensed',
+    effective_plan: null,
+    last_checked_at: null,
+    grace_until: null,
+    expires_at: null,
+    control_plane_url: 'https://license.example.test',
+    updated_at: '2026-08-19T00:00:00.000Z',
+    ...overrides,
+  };
+}
+
+test('readLicenseState maps a valid singleton from D1 snake_case columns', async () => {
+  const db = new FakeLicenseD1(validRaw({ signed_token: 'signed', effective_plan: 'pro' }));
+  const state = await readLicenseState(db as any);
+  assert.deepEqual(state, {
+    id: 1,
+    installationId: '8cd13a85-a578-44d6-9efb-68730d57dcc3',
+    signedToken: 'signed',
+    status: 'unlicensed',
+    effectivePlan: 'pro',
+    lastCheckedAt: null,
+    graceUntil: null,
+    expiresAt: null,
+    controlPlaneUrl: 'https://license.example.test',
+    updatedAt: '2026-08-19T00:00:00.000Z',
+  });
+});
+
+test('ensureLicenseState creates one persisted UUID and trims the control plane URL', async () => {
+  const db = new FakeLicenseD1();
+  const first = await ensureLicenseState(db as any, '  https://license.example.test  ');
+  assert.equal(first.id, 1);
+  assert.match(first.installationId, /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i);
+  assert.equal(first.status, 'unlicensed');
+  assert.equal(first.signedToken, null);
+  assert.equal(first.effectivePlan, null);
+  assert.equal(first.lastCheckedAt, null);
+  assert.equal(first.graceUntil, null);
+  assert.equal(first.expiresAt, null);
+  assert.equal(first.controlPlaneUrl, 'https://license.example.test');
+  assert.ok(!Number.isNaN(Date.parse(first.updatedAt)));
+  assert.equal(db.insertAttempts, 1);
+});
+
+test('ensureLicenseState preserves existing installation identity and URL', async () => {
+  const db = new FakeLicenseD1();
+  const first = await ensureLicenseState(db as any, 'https://license.example.test');
+  const second = await ensureLicenseState(db as any, 'https://different.example.test');
+  assert.equal(second.installationId, first.installationId);
+  assert.equal(second.controlPlaneUrl, first.controlPlaneUrl);
+  assert.equal(db.insertAttempts, 1);
+});
+
+test('ensureLicenseState rejects whitespace-only control plane URL before any D1 access', async () => {
+  const db = new FakeLicenseD1();
+  await assert.rejects(() => ensureLicenseState(db as any, '   '), /LICENSE_CONTROL_PLANE_URL_REQUIRED/);
+  assert.deepEqual(db.statements, []);
+  assert.equal(db.insertAttempts, 0);
+});
+
+test('readLicenseState rejects malformed persisted singleton instead of replacing identity', async () => {
+  const db = new FakeLicenseD1(validRaw({ installation_id: ' ' }));
+  await assert.rejects(() => readLicenseState(db as any), /LICENSE_STATE_INVALID/);
+  await assert.rejects(() => ensureLicenseState(db as any, 'https://license.example.test'), /LICENSE_STATE_INVALID/);
+  assert.equal(db.insertAttempts, 0);
+});
+
+test('concurrent first bootstraps converge on the one singleton persisted by INSERT OR IGNORE', async () => {
+  const db = new FakeLicenseD1();
+  const [a, b] = await Promise.all([
+    ensureLicenseState(db as any, 'https://license.example.test'),
+    ensureLicenseState(db as any, 'https://license.example.test'),
+  ]);
+  assert.equal(db.insertAttempts, 2, 'both callers may race to INSERT OR IGNORE');
+  assert.equal(a.installationId, b.installationId);
+  assert.equal(a.installationId, db.row?.installation_id);
+  assert.equal(a.controlPlaneUrl, db.row?.control_plane_url);
+});
