+
+test('customer package audit rejects V16 Task 2 master-only regression tests', async () => {
+  const { auditCustomerTree } = await import('../scripts/package-audit.mjs');
+  const root = await mkdtemp(join(tmpdir(), 'dorm-v16-task2-test-audit-'));
+  try {
+    await mkdir(join(root, 'tests'), { recursive: true });
+    for (const name of ['license-state-migration.test.mjs', 'license-state-service.test.ts', 'license-state-backup-boundary.test.mjs']) {
+      await writeFile(join(root, 'tests', name), 'test-only');
+    }
+    await writeFile(join(root, 'package.json'), JSON.stringify({ name: 'dorm-management-system-demo', scripts: {} }));
+    const issues = await auditCustomerTree(root, { id: 'demo', packageName: 'dorm-management-system-demo' });
+    for (const name of ['license-state-migration.test.mjs', 'license-state-service.test.ts', 'license-state-backup-boundary.test.mjs']) {
+      assert.ok(issues.some((x) => x.includes(`tests/${name}`)), `audit did not reject tests/${name}`);
+    }
+  } finally { await rm(root, { recursive: true, force: true }); }
+});
