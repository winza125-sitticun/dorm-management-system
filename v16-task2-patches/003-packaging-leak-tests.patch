   }
 });
+
+test('builder excludes V16 Task 2 master-only regression tests from customer staging', async () => {
+  const { buildPackageTree, loadPlans } = await import('../scripts/build-packages.mjs');
+  const output = await mkdtemp(join(tmpdir(), 'dorm-v16-task2-master-only-'));
+  try {
+    const plans = await loadPlans();
+    const destination = join(output, 'demo');
+    await buildPackageTree(plans.demo, { destination, runPortableTests: false, customerReady: false });
+    for (const rel of [
+      'tests/license-state-migration.test.mjs',
+      'tests/license-state-service.test.ts',
+      'tests/license-state-backup-boundary.test.mjs',
+    ]) {
+      assert.equal(existsSync(join(destination, rel)), false, `customer package leaked ${rel}`);
+    }
+  } finally {
+    await rm(output, { recursive: true, force: true });
+  }
+});
