+
+
+type RestoreRow = Record<string, unknown>;
+
+class RestoreFakeStatement {
+  public args: unknown[] = [];
+  constructor(public db: RestoreFakeD1, public sql: string) {}
+  bind(...args: unknown[]) { this.args = args; return this; }
+  async first<T = RestoreRow>(): Promise<T | null> { return this.db.first(this.sql, this.args) as T | null; }
+  async all<T = RestoreRow>(): Promise<{ results: T[] }> { return { results: this.db.all(this.sql, this.args) as T[] }; }
+  async run(): Promise<{ success: boolean }> { this.db.apply(this.sql, this.args); return { success: true }; }
+}
+
+class RestoreFakeD1 {
+  public settings: RestoreRow = {
+    dorm_name: 'Current Dorm', default_elec_rate: 7, default_water_rate: 13,
+    default_due_date_day: 5, default_penalty_rate: 100, promptpay_id: null, promptpay_name: null,
+    font_scale: 'medium', brand_color: '#112233', contact_phone: '0899999999',
+    bill_footer: 'Current footer', brand_logo_key: 'keep-logo',
+    line_channel_access_token: 'keep-token', line_channel_secret: 'keep-secret', line_bot_enabled: 1,
+    google_spreadsheet_id: 'keep-sheet', subscription_plan: 'pro', subscription_status: 'active', subscription_expires_at: null,
+  };
+  prepare(sql: string) { return new RestoreFakeStatement(this, sql); }
+  async batch(statements: RestoreFakeStatement[]): Promise<Array<{ success: boolean }>> {
+    return statements.map((stmt) => { this.apply(stmt.sql, stmt.args); return { success: true }; });
+  }
+  private q(sql: string) { return sql.replace(/\s+/g, ' ').trim().toLowerCase(); }
+  first(sql: string, args: unknown[]): RestoreRow | null {
+    const q = this.q(sql);
+    if (q.includes('select uid from users')) return { uid: 'owner-public-uid' };
+    if (q.includes('select id from users')) return { id: Number(args[0]) };
+    if (q.includes('from settings')) return { ...this.settings };
+    return null;
+  }
+  all(sql: string, _args: unknown[]): RestoreRow[] {
+    const q = this.q(sql);
+    if (q.includes('from users')) return [{ id: 7, parent_id: null }];
+    return [];
+  }
+  apply(sql: string, args: unknown[]) {
+    const q = this.q(sql);
+    if (!q.startsWith('update settings set')) return;
+    const keys = ['dorm_name','default_elec_rate','default_water_rate','default_due_date_day','default_penalty_rate','promptpay_id','promptpay_name','font_scale','brand_color','contact_phone','bill_footer'];
+    keys.forEach((key, index) => { this.settings[key] = args[index]; });
+  }
+}
+
+function restoreCurrentState(db: RestoreFakeD1) {
+  return {
+    integrations: {
+      rooms: [],
+      settings: {
+        lineChannelAccessToken: db.settings.line_channel_access_token,
+        lineChannelSecret: db.settings.line_channel_secret,
+        lineBotEnabled: db.settings.line_bot_enabled,
+        googleSpreadsheetId: db.settings.google_spreadsheet_id,
+        subscriptionPlan: db.settings.subscription_plan,
+        subscriptionStatus: db.settings.subscription_status,
+        subscriptionExpiresAt: db.settings.subscription_expires_at,
+        brandColor: db.settings.brand_color,
+        contactPhone: db.settings.contact_phone,
+        billFooter: db.settings.bill_footer,
+        brandLogoKey: db.settings.brand_logo_key,
+      },
+    },
+    existingUserIds: new Set([7]),
+    childUserIds: new Set<number>(),
+  };
+}
+
+test('v6 restore preserves current V15 portable brand fields and server-managed logo key', async () => {
+  const db = new RestoreFakeD1();
+  const v6 = backupDataV6(emptyBackupData());
+  const prepared = prepareRestoreData(v6 as any, restoreCurrentState(db) as any, 7, 6);
+  assert.equal((prepared.settings as any).brandColor, '#112233');
+  assert.equal((prepared.settings as any).contactPhone, '0899999999');
+  assert.equal((prepared.settings as any).billFooter, 'Current footer');
+  await restoreBusinessBackup(db as any, 7, prepared);
+  assert.equal(db.settings.brand_color, '#112233');
+  assert.equal(db.settings.contact_phone, '0899999999');
+  assert.equal(db.settings.bill_footer, 'Current footer');
+  assert.equal(db.settings.brand_logo_key, 'keep-logo');
+});
+
+test('v7 restore applies portable brand fields while preserving logo and integration state', async () => {
+  const db = new RestoreFakeD1();
+  const v7 = emptyBackupData();
+  v7.settings.brandColor = '#1DB954';
+  v7.settings.contactPhone = '081-234-5678';
+  v7.settings.billFooter = 'Restored footer';
+  const prepared = prepareRestoreData(v7, restoreCurrentState(db) as any, 7, 7);
+  await restoreBusinessBackup(db as any, 7, prepared);
+  assert.equal(db.settings.brand_color, '#1DB954');
+  assert.equal(db.settings.contact_phone, '081-234-5678');
+  assert.equal(db.settings.bill_footer, 'Restored footer');
+  assert.equal(db.settings.brand_logo_key, 'keep-logo');
+  assert.equal(db.settings.line_channel_secret, 'keep-secret');
+  assert.equal(db.settings.google_spreadsheet_id, 'keep-sheet');
+  assert.equal(db.settings.subscription_plan, 'pro');
+});
