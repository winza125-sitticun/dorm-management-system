+
+
+export function backupDataV6(data: BackupDataV1 = emptyBackupData()): Record<string, unknown> {
+  const { brandColor: _brandColor, contactPhone: _contactPhone, billFooter: _billFooter, ...settings } = data.settings;
+  return { ...data, settings };
+}
+
+export async function manifestForV6(data: Record<string, unknown>, ownerScope = 'a'.repeat(64)): Promise<Record<string, unknown>> {
+  const typed = data as BackupDataV1;
+  return {
+    format: BACKUP_FORMAT,
+    formatVersion: BACKUP_FORMAT_VERSION,
+    appVersion: '1.1.0',
+    schemaVersion: 6,
+    createdAt: '2026-08-16T00:00:00.000Z',
+    ownerScope,
+    dormName: String((data.settings as Record<string, unknown>).dormName),
+    counts: computeBackupCounts(typed),
+    excluded: ['users', 'integration_secrets'],
+    dataSha256: await sha256Hex(stableStringify(data)),
+  };
+}
