+
+test('V15 backup contract uses schemaVersion 7 while keeping formatVersion 1', () => {
+  assert.equal(BACKUP_FORMAT_VERSION, 1);
+  assert.equal(BACKUP_LEGACY_SCHEMA_VERSION, 6);
+  assert.equal(BACKUP_SCHEMA_VERSION, 7);
+});
+
+test('v7 strict settings require portable white-label fields and reject logo references', () => {
+  const v7 = emptyBackupData();
+  assert.equal(BackupDataSchema.parse(v7).settings.brandColor, '#1DB954');
+
+  const missingBrand: any = structuredClone(v7);
+  delete missingBrand.settings.brandColor;
+  assert.throws(() => BackupDataSchema.parse(missingBrand));
+
+  const logoLeak: any = structuredClone(v7);
+  logoLeak.settings.brandLogoKey = 'owner/logo.png';
+  assert.throws(() => BackupDataSchema.parse(logoLeak));
+});
+
+test('restore request accepts strict v6 and v7 pairs but rejects schema/data mismatch', async () => {
+  const v7 = emptyBackupData();
+  const v7Manifest = await manifestFor(v7);
+  assert.doesNotThrow(() => BackupRestoreRequestSchema.parse({ manifest: v7Manifest, data: v7 }));
+
+  const v6 = backupDataV6(v7);
+  const v6Manifest = await manifestForV6(v6);
+  assert.doesNotThrow(() => BackupRestoreRequestSchema.parse({ manifest: v6Manifest, data: v6 }));
+  assert.throws(() => BackupRestoreRequestSchema.parse({ manifest: v6Manifest, data: v7 }));
+  assert.throws(() => BackupRestoreRequestSchema.parse({ manifest: v7Manifest, data: v6 }));
+});
+
+test('server restore validation accepts a valid V14 schemaVersion 6 backup', async () => {
+  const db = new ValidationDb();
+  const ownerScope = await computeOwnerScope(db.uid);
+  const v6 = backupDataV6(emptyBackupData());
+  const manifest = await manifestForV6(v6, ownerScope);
+  const result = await validateBackupForRestore(db as any, db.ownerId, SECRET, { manifest, data: v6 });
+  assert.equal(result.valid, true);
+});
