   await assert.rejects(() => validateBackupForRestore(db as any, 7, SECRET, { manifest: { ...manifest, ownerScope: 'f'.repeat(64) }, data }), (e: any) => e instanceof BackupValidationError && e.code === 'BACKUP_OWNER_SCOPE_MISMATCH');
