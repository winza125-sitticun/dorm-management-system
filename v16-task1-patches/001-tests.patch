+test('customer package audit rejects the vendor-only control-plane root', async () => {
+  const { auditCustomerTree } = await import('../scripts/package-audit.mjs');
+  const root = await mkdtemp(join(tmpdir(), 'dorm-v16-control-plane-audit-'));
+  try {
+    await mkdir(join(root, 'control-plane'), { recursive: true });
+    await writeFile(join(root, 'control-plane', 'vendor-only-marker.txt'), 'vendor only');
+    await writeFile(join(root, 'package.json'), JSON.stringify({ name: 'dorm-management-system-demo', scripts: {} }));
+    const issues = await auditCustomerTree(root, { id: 'demo', packageName: 'dorm-management-system-demo' });
+    assert.ok(issues.some((x) => /control-plane\/vendor-only-marker\.txt/.test(x)));
+  } finally { await rm(root, { recursive: true, force: true }); }
+});
+
+
+test('customer package audit rejects the license signing private secret identifier', async () => {
+  const { auditCustomerTree } = await import('../scripts/package-audit.mjs');
+  const root = await mkdtemp(join(tmpdir(), 'dorm-v16-signing-secret-audit-'));
+  try {
+    await writeFile(join(root, 'package.json'), JSON.stringify({ name: 'dorm-management-system-demo', scripts: {} }));
+    await writeFile(join(root, 'customer-notes.txt'), 'LICENSE_SIGNING_PRIVATE_KEY=should-never-ship');
+    const issues = await auditCustomerTree(root, { id: 'demo', packageName: 'dorm-management-system-demo' });
+    assert.ok(issues.some((x) => /LICENSE_SIGNING_PRIVATE_KEY|signing private key/i.test(x)));
+  } finally { await rm(root, { recursive: true, force: true }); }
+});
