+    for (const name of ['license-token-canonicalization.test.ts', 'license-token-verification.test.ts']) {
+      assert.ok(issues.some((x) => x.includes(`tests/${name}`)), `audit did not reject tests/${name}`);
+    }
+  } finally { await rm(root, { recursive: true, force: true }); }
+});
