diff --git a/control-plane/src/licenseRepository.ts b/control-plane/src/licenseRepository.ts
new file mode 100644
index 0000000..ab64337
--- /dev/null
+++ b/control-plane/src/licenseRepository.ts
@@ -0,0 +1,47 @@
+export class LicenseRepositoryError extends Error {
+  constructor(message = 'LICENSE_KEY_INVALID') {
+    super(message);
+    this.name = 'LicenseRepositoryError';
+  }
+}
+
+export async function hashLicenseKey(rawLicenseKey: string): Promise<string> {
+  const normalized = rawLicenseKey.trim();
+  if (!normalized) throw new LicenseRepositoryError();
+  const digest = new Uint8Array(await crypto.subtle.digest('SHA-256', new TextEncoder().encode(normalized)));
+  return Array.from(digest, (byte) => byte.toString(16).padStart(2, '0')).join('');
+}
+
+export interface ControlPlaneD1Like {
+  prepare(query: string): {
+    bind(...values: unknown[]): {
+      first<T>(): Promise<T | null>;
+      all<T>(): Promise<{ results?: T[] }>;
+    };
+  };
+}
+
+export interface LicenseRecord {
+  id: string;
+  key_hash: string;
+  customer_label: string | null;
+  plan: 'basic' | 'standard' | 'pro';
+  status: 'active' | 'suspended' | 'revoked' | 'expired';
+  max_activations: number;
+  expires_at: number | null;
+  created_at: string;
+  updated_at: string;
+}
+
+export async function findLicenseById(db: ControlPlaneD1Like, id: string): Promise<LicenseRecord | null> {
+  return db.prepare('SELECT * FROM licenses WHERE id = ? LIMIT 1').bind(id).first<LicenseRecord>();
+}
+
+export async function findLicenseByKeyHash(db: ControlPlaneD1Like, keyHash: string): Promise<LicenseRecord | null> {
+  return db.prepare('SELECT * FROM licenses WHERE key_hash = ? LIMIT 1').bind(keyHash).first<LicenseRecord>();
+}
+
+export async function countActiveActivations(db: ControlPlaneD1Like, licenseId: string): Promise<number> {
+  const row = await db.prepare('SELECT COUNT(*) AS count FROM activations WHERE license_id = ? AND revoked_at IS NULL').bind(licenseId).first<{ count: number }>();
+  return Number(row?.count ?? 0);
+}
diff --git a/control-plane/src/signing.ts b/control-plane/src/signing.ts
new file mode 100644
index 0000000..80b6091
--- /dev/null
+++ b/control-plane/src/signing.ts
@@ -0,0 +1,47 @@
+import { canonicalizeSigningPayload, type SignLicensePayloadInput } from './token.ts';
+export type { SignLicensePayloadInput } from './token.ts';
+
+const BASE64URL = /^[A-Za-z0-9_-]+$/;
+
+function encodeBase64Url(bytes: Uint8Array): string {
+  let binary = '';
+  for (const byte of bytes) binary += String.fromCharCode(byte);
+  return btoa(binary).replaceAll('+', '-').replaceAll('/', '_').replace(/=+$/u, '');
+}
+
+function decodeBase64UrlStrict(value: string): Uint8Array {
+  if (!value || value.includes('=') || !BASE64URL.test(value) || value.length % 4 === 1) {
+    throw new Error('LICENSE_SIGNING_KEY_INVALID');
+  }
+  try {
+    const base64 = value.replaceAll('-', '+').replaceAll('_', '/');
+    const padded = base64 + '='.repeat((4 - (base64.length % 4)) % 4);
+    const binary = atob(padded);
+    const bytes = Uint8Array.from(binary, (character) => character.charCodeAt(0));
+    if (bytes.length === 0 || encodeBase64Url(bytes) !== value) throw new Error('invalid');
+    return bytes;
+  } catch {
+    throw new Error('LICENSE_SIGNING_KEY_INVALID');
+  }
+}
+
+export async function importLicenseSigningPrivateKey(pkcs8Base64Url: string): Promise<CryptoKey> {
+  try {
+    const bytes = decodeBase64UrlStrict(pkcs8Base64Url);
+    return await crypto.subtle.importKey('pkcs8', bytes, { name: 'Ed25519' }, false, ['sign']);
+  } catch {
+    throw new Error('LICENSE_SIGNING_KEY_INVALID');
+  }
+}
+
+export async function signLicenseToken(payload: SignLicensePayloadInput, privateKey: CryptoKey): Promise<string> {
+  const canonical = canonicalizeSigningPayload(payload);
+  const payloadBytes = new TextEncoder().encode(canonical);
+  let signature: ArrayBuffer;
+  try {
+    signature = await crypto.subtle.sign({ name: 'Ed25519' }, privateKey, payloadBytes);
+  } catch {
+    throw new Error('LICENSE_SIGNING_FAILED');
+  }
+  return `dormlic1.${encodeBase64Url(payloadBytes)}.${encodeBase64Url(new Uint8Array(signature))}`;
+}
diff --git a/control-plane/src/token.ts b/control-plane/src/token.ts
new file mode 100644
index 0000000..1bd0787
--- /dev/null
+++ b/control-plane/src/token.ts
@@ -0,0 +1,38 @@
+export type ControlPlaneLicensePlan = 'basic' | 'standard' | 'pro';
+export type ControlPlaneLicenseStatus = 'active' | 'suspended' | 'revoked' | 'expired';
+
+export interface SignLicensePayloadInput {
+  licenseId: string;
+  installationId: string;
+  plan: ControlPlaneLicensePlan;
+  status: ControlPlaneLicenseStatus;
+  issuedAt: number;
+  expiresAt: number;
+  refreshAfter: number;
+}
+
+export function validateSignLicensePayload(payload: SignLicensePayloadInput): void {
+  if (!payload.licenseId.trim() || !payload.installationId.trim()) throw new Error('LICENSE_TOKEN_INVALID');
+  if (!['basic', 'standard', 'pro'].includes(payload.plan)) throw new Error('LICENSE_TOKEN_INVALID');
+  if (!['active', 'suspended', 'revoked', 'expired'].includes(payload.status)) throw new Error('LICENSE_TOKEN_INVALID');
+  for (const value of [payload.issuedAt, payload.expiresAt, payload.refreshAfter]) {
+    if (!Number.isFinite(value) || !Number.isInteger(value)) throw new Error('LICENSE_TOKEN_INVALID');
+  }
+  if (!(payload.issuedAt <= payload.refreshAfter && payload.refreshAfter <= payload.expiresAt)) {
+    throw new Error('LICENSE_TOKEN_INVALID');
+  }
+}
+
+export function canonicalizeSigningPayload(payload: SignLicensePayloadInput): string {
+  validateSignLicensePayload(payload);
+  return JSON.stringify({
+    v: 1,
+    licenseId: payload.licenseId,
+    installationId: payload.installationId,
+    plan: payload.plan,
+    status: payload.status,
+    issuedAt: payload.issuedAt,
+    expiresAt: payload.expiresAt,
+    refreshAfter: payload.refreshAfter,
+  });
+}
