{
  "name": "dorm-management-system-master",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "predev": "npm run version:sync",
    "dev": "tsx server.ts",
    "build": "npm run build:pages",
    "prebuild:pages": "npm run version:sync",
    "build:pages": "vite build",
    "prebuild:vps": "npm run version:sync",
    "build:vps": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist-server/server.cjs",
    "start": "node dist-server/server.cjs",
    "preview": "vite preview",
    "deploy": "npm run deploy:pages",
    "predeploy:pages": "npm run release:check",
    "deploy:pages": "npm run build:pages && wrangler pages deploy",
    "pages:dev": "npm run build:pages && wrangler pages dev dist",
    "d1:push": "npm run d1:migrate:local",
    "d1:migrate:local": "wrangler d1 migrations apply DB --local",
    "d1:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "d1:backup": "node scripts/d1-export.mjs --remote ./backups/d1_backup.sql",
    "d1:export": "node scripts/d1-export.mjs --local ./backups/d1_local_backup.sql",
    "types:cloudflare": "wrangler types",
    "check:cloudflare-types": "wrangler types --check",
    "clean": "node -e \"['dist','dist-server','server.js'].forEach(f=>require('fs').rmSync(f,{recursive:true,force:true}))\"",
    "lint": "tsc --noEmit && tsc -p tsconfig.cloudflare.json",
    "test": "npm run test:settings && npm run test:notes && npm run test:regression && npm run test:rbac && npm run test:navigation && npm run test:plans && npm run test:license && npm run test:setup:master && npm run test:upgrade && npm run test:backup && npm run test:handoff && npm run test:bill-branding && npm run test:builder",
    "test:settings": "tsx --test tests/settings-utils.test.ts",
    "test:notes": "tsx --test tests/notes-security.test.ts",
    "test:regression": "tsx --test tests/core-regression.test.ts",
    "test:rbac": "tsx --test tests/rbac-recurring-housekeeping.test.ts",
    "test:navigation": "tsx --test tests/app-navigation.test.ts tests/dashboard-exit-integration.test.ts",
    "version:sync": "node scripts/sync-version.mjs",
    "version:show": "node -p \"'v' + require('./package.json').version\"",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "version": "npm run version:sync",
    "release:check": "npm run version:sync && npm test && npm run lint && npm run check:cloudflare-types:master",
    "test:plans": "tsx --test tests/plan-entitlements.test.ts tests/plan-navigation.test.ts tests/plan-persistence.test.ts tests/plan-api-guards.test.ts",
    "test:handoff": "tsx --test tests/customer-handoff.test.ts",
    "customer:preflight": "node scripts/customer-preflight.mjs",
    "setup:cloudflare": "node SETUP-CLOUDFLARE.mjs",
    "deploy:customer": "node SETUP-CLOUDFLARE.mjs --deploy",
    "test:setup": "node --test tests/setup-cloudflare.test.mjs tests/customer-preflight.test.mjs tests/windows-launchers.test.mjs tests/d1-export-windows.test.mjs tests/final-delivery.test.mjs",
    "plan:show": "node UPGRADE-PACKAGE.mjs --show",
    "upgrade:package": "node UPGRADE-PACKAGE.mjs",
    "test:upgrade": "node --test tests/plan-upgrade-manager.test.mjs tests/upgrade-orchestration.test.mjs tests/upgrade-e2e-simulation.test.mjs tests/upgrade-bootstrap-existing.test.mjs tests/upgrade-handoff.test.mjs",
    "packages:generate": "node scripts/build-packages.mjs --preview",
    "test:builder": "node --test tests/package-builder.test.mjs tests/package-parity.test.mjs tests/package-audit.test.mjs tests/package-release.test.mjs tests/master-launchers.test.mjs tests/zip-utils.test.mjs",
    "packages:release": "node scripts/release-packages.mjs",
    "test:setup:master": "node --test tests/setup-cloudflare.test.mjs tests/customer-preflight.test.mjs tests/windows-launchers.test.mjs tests/d1-export-windows.test.mjs tests/bill-mobile-desktop-layout.test.mjs",
    "check:cloudflare-types:master": "wrangler types --config wrangler.master.jsonc --check",
    "test:backup": "tsx --test tests/backup-archive.test.ts tests/backup-validation.test.ts tests/backup-restore.test.ts tests/backup-restore-api.test.ts",
    "test:bill-branding": "tsx --test tests/bill-branding-snapshot.test.ts",
    "test:license": "node --test tests/license-settings-ui.test.mjs tests/license-public-config.test.mjs tests/license-lifecycle-readonly.test.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "fflate": "^0.8.3",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.22.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.9.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wrangler": "^4.118.0"
  }
}
